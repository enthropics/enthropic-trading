# =================================================
# Enthropic Trading Platform - Environment Variables
# Phase 1-4: Complete Enterprise Configuration
# =================================================

# ==========================================
# PHASE 1: PERSISTENCE
# ==========================================

# PostgreSQL + TimescaleDB
DATABASE_URL=postgres://postgres:postgres@localhost:5432/enthropic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=enthropic

# Redis (Token blacklist, Rate limiting, Caching)
REDIS_URL=redis://localhost:6379

# NATS Messaging
NATS_URL=nats://localhost:4222

# ==========================================
# PHASE 2: AUTHENTICATION & AUTHORIZATION
# ==========================================

# JWT Configuration
# IMPORTANT: Generate new secret for production: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# HashiCorp Vault (Production secrets management)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-token-123

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=15

# ==========================================
# PHASE 3: OBSERVABILITY & RESILIENCE
# ==========================================

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=enthropic-trading

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# Jaeger Tracing
JAEGER_UI_PORT=16686

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
RUST_LOG=info,execution_core=debug

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT_SECONDS=30

# Retry Configuration
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=100
RETRY_MAX_DELAY_MS=10000
RETRY_MULTIPLIER=2.0

# ==========================================
# PHASE 4: SCALABILITY & HA
# ==========================================

# Kubernetes/Container
ENVIRONMENT=development
NAMESPACE=enthropic

# Service Ports
DASHBOARD_PORT=5173
NATS_GATEWAY_PORT=3002
RISK_SERVICE_PORT=3001
EXECUTION_CORE_METRICS_PORT=9100
STRATEGY_SERVICE_METRICS_PORT=9102

# Auto-scaling thresholds
AUTOSCALE_CPU_THRESHOLD=70
AUTOSCALE_MEMORY_THRESHOLD=80
AUTOSCALE_MIN_REPLICAS=2
AUTOSCALE_MAX_REPLICAS=10

# Database Pool
POOL_MIN_CONNECTIONS=5
POOL_MAX_CONNECTIONS=20

# CORS
CORS_ORIGIN=http://localhost:5173

# ==========================================
# CI/CD (GitHub Actions)
# ==========================================
# These are typically set as GitHub Secrets
# KUBE_CONFIG_STAGING=<base64-encoded-kubeconfig>
# KUBE_CONFIG_PRODUCTION=<base64-encoded-kubeconfig>
# REGISTRY_USERNAME=<container-registry-username>
# REGISTRY_PASSWORD=<container-registry-password>
